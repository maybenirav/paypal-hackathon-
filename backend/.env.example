# Everything here is optional for the simulated demo. Copy to backend/.env and fill in what you need.

# --- AI (without a key, PlanLab uses built-in price templates and explanations) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- PayPal sandbox (needed only for real plans, subscriptions and webhooks) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Run `python scripts/create_product.py` once and paste the id it prints
PAYPAL_PRODUCT_ID=
PAYPAL_BRAND_NAME=PlanLab Demo

# Where PayPal sends the buyer after checkout. Must match where the frontend runs.
FRONTEND_URL=http://localhost:3000
# Optional overrides; they default to FRONTEND_URL + /subscribe/success and /subscribe/cancel
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# Webhook id from the PayPal dashboard. Webhooks need a public URL (deploy, or use a tunnel).
PAYPAL_WEBHOOK_ID=
# Set to false ONLY for local testing with hand-made events
PAYPAL_WEBHOOK_VERIFY=true

# --- APIMatic (optional remote plan validation; local JSON Schema checks always run) ---
APIMATIC_API_KEY=
APIMATIC_VALIDATE_URL=

# --- Automatic guardrail checks ---
# How often experiments with real data are checked, in seconds. 0 turns the background checks off
# GUARDRAIL_CHECK_SECONDS=900

# --- Alerts when an option is stopped automatically (Slack, email, both or neither) ---
# A Slack incoming webhook, or any service that accepts a JSON "text" field. Keep this URL secret
ALERT_WEBHOOK_URL=
# Email: who to tell (comma-separated) and your mail server. Port 587 uses STARTTLS and 465 uses TLS directly
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME
SMTP_FROM=

# --- Data and deployment ---
# Where experiments are saved. Leave unset for backend/planlab.db, or set it empty to keep data in memory only
# PLANLAB_DB=
# Other websites allowed to call this API, comma-separated. localhost is always allowed
# CORS_ORIGINS=https://planlab.example.com
# A shared secret every API call must send. Set the same value as NEXT_PUBLIC_API_TOKEN in the frontend.
# It stops casual access, but it ends up in the browser's code, so it isn't a real login
# PLANLAB_API_TOKEN=
