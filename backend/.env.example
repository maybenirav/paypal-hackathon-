# PayPal sandbox app (developer.paypal.com -> Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRODUCT_ID=            # run: python scripts/create_product.py
PAYPAL_WEBHOOK_ID=            # after adding <backend-url>/webhooks/paypal in the PayPal dashboard
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
FRONTEND_URL=http://localhost:3000

# Sandbox buyer accounts the KERNEL bots log in as
PAYPAL_SANDBOX_BUYER_1_EMAIL=
PAYPAL_SANDBOX_BUYER_1_PASSWORD=

# Gemini (pricing agent, cancel-reason classifier, explanations); falls back if overloaded
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# KERNEL cloud browsers (real sandbox checkouts)
KERNEL_API_KEY=

# Save Agent: false = log requests only (dry run), true = send them to the PayPal sandbox
SAVE_AGENT_LIVE=false

# Storage and demo
DATABASE_URL=                 # Supabase Postgres (see db/schema.sql); when set it stores experiments
PLANLAB_DB=planlab.db         # SQLite file: everything without Supabase, else Save Agent log + memory
SEED_DEMO=true                # seed a labelled demo merchant when the database is empty

# Decision memory: optional Elasticsearch (Elastic Cloud: endpoint URL + API key).
# Without it, decisions are searched locally.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=planlab-decisions
